<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        xmlns:vm="using:HljuML.App.Core"
        xmlns:views="using:HljuML.App.Views"
        xmlns:home="using:HljuML.App.Views.Home"
        xmlns:shell="using:HljuML.App.Views.Shell"
        x:Class="HljuML.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="HljuML"
        Width="1120"
        Height="720"
        MinWidth="560"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        RequestedThemeVariant="Light"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="{StaticResource CanvasBrush}">
    <Grid>
        <Border x:Name="WindowFrame" Classes="rounded-window" Background="{StaticResource CanvasBrush}" />
        <Border CornerRadius="{Binding #WindowFrame.CornerRadius}" ClipToBounds="True" IsHitTestVisible="False">
            <Image Source="{Binding Settings.BackgroundImage}" Stretch="UniformToFill" />
        </Border>
        <Grid Margin="24,0" RowDefinitions="Auto,*,Auto,Auto">
            <shell:LauncherTitleBar x:Name="TitleBar"
                                    Margin="0,16,0,8"
                                    MaxWidth="864"
                                    HomeRequested="OnHomeClicked"
                                    DownloadsRequested="OnDownloadsClicked"
                                    SettingsRequested="OnSettingsClicked"
                                    LogsRequested="OnLogsClicked"
                                    MinimizeRequested="OnMinimizeClicked"
                                    MaximizeRequested="OnMaximizeClicked"
                                    CloseRequested="OnCloseClicked" />
            <ScrollViewer x:Name="PageScroll"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="1080" Margin="0,16">
                    <home:HomeView x:Name="HomePage" />
                </Grid>
            </ScrollViewer>
            <views:DownloadHubView x:Name="DownloadsPage"
                                   Grid.Row="1"
                                   IsVisible="False"
                                   MaxWidth="1080"
                                   Tag="{arc:ArcDesignTokenResource Space4}"
                                   Margin="{Binding $self.Tag, Converter={StaticResource UniformThicknessConverter}}"
                                   DataContext="{Binding DownloadHub}" />
            <views:SettingsView x:Name="SettingsPage"
                                Grid.Row="1"
                                IsVisible="False"
                                MaxWidth="1080"
                                Tag="{arc:ArcDesignTokenResource Space4}"
                                Margin="{Binding $self.Tag, Converter={StaticResource UniformThicknessConverter}}"
                                DataContext="{Binding Settings}" />
            <arc:ToastStack Grid.Row="1" Label="通知" IsContained="True" />
            <arc:Button Grid.Row="2"
                        Size="Small"
                        Variant="Secondary"
                        HorizontalAlignment="Center"
                        Content="查看下载管理器"
                        IsVisible="{Binding Downloads.HasPendingOrFailedTasks}"
                        Click="OnDownloadManagerClicked" />
            <shell:LaunchDock Grid.Row="3"
                              Margin="0,8,0,16"
                              MaxWidth="1040"
                              AccountRequested="OnAccountClicked"
                              InstanceRequested="OnChooseInstanceClicked"
                              LaunchRequested="OnLaunchClicked" />
        </Grid>
        <Grid x:Name="ResizeGrips" RowDefinitions="6,*,6" ColumnDefinitions="6,*,6">
            <Border Classes="resize-grip" WindowDecorationProperties.ElementRole="ResizeNW" />
            <Border Classes="resize-grip" Grid.Column="1" WindowDecorationProperties.ElementRole="ResizeN" />
            <Border Classes="resize-grip" Grid.Column="2" WindowDecorationProperties.ElementRole="ResizeNE" />
            <Border Classes="resize-grip" Grid.Row="1" WindowDecorationProperties.ElementRole="ResizeW" />
            <Border Classes="resize-grip" Grid.Row="1" Grid.Column="2" WindowDecorationProperties.ElementRole="ResizeE" />
            <Border Classes="resize-grip" Grid.Row="2" WindowDecorationProperties.ElementRole="ResizeSW" />
            <Border Classes="resize-grip" Grid.Row="2" Grid.Column="1" WindowDecorationProperties.ElementRole="ResizeS" />
            <Border Classes="resize-grip" Grid.Row="2" Grid.Column="2"
                    WindowDecorationProperties.ElementRole="ResizeSE" />
        </Grid>
        <Border x:Name="SelectionScrim"
                IsVisible="False"
                IsHitTestVisible="False"
                CornerRadius="{Binding #WindowFrame.CornerRadius}"
                Background="{arc:ArcDesignTokenResource Scrim}" />
        <views:ModpackImportDialog DataContext="{Binding ModpackImport}" />
    </Grid>
</Window>