<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        xmlns:layout="using:HljuML.App.Controls"
        xmlns:vm="using:HljuML.App.Core"
        xmlns:views="using:HljuML.App.Views"
        x:Class="HljuML.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="HljuML · Minecraft 启动器"
        Width="1120" Height="720" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None" ExtendClientAreaToDecorationsHint="True"
        RequestedThemeVariant="Light" Background="Transparent"
        TransparencyLevelHint="Transparent" TransparencyBackgroundFallback="{StaticResource CanvasBrush}">
    <Window.Resources>
        <vm:UniformThicknessConverter x:Key="UniformThicknessConverter" />
        <LinearGradientBrush x:Key="CanvasBrush" StartPoint="0%,0%" EndPoint="85%,100%">
            <GradientStop Color="#E8F6FF" Offset="0" />
            <GradientStop Color="#88C5F0" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#D5EFFF" Offset="0" />
            <GradientStop Color="#B9DCF8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0%,0%" EndPoint="80%,100%">
            <GradientStop Color="#E7FFFFFF" Offset="0" />
            <GradientStop Color="#B09FC9E8" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBrush" Color="#EAF7FCFF" />
        <ImageBrush x:Key="InstanceIconBrush" Source="avares://HljuML.App/Assets/instance_icon_default.jpg"
                    Stretch="UniformToFill" />
        <CornerRadius x:Key="WindowRadius">24</CornerRadius>
        <CornerRadius x:Key="InstanceIconRadius">8</CornerRadius>
        <Thickness x:Key="FloatingPadding">16,8</Thickness>
        <StreamGeometry x:Key="BrandGlyph">M12,2 L22,7.5 V17 L12,22.5 L2,17 V7.5 Z M2,7.5 L12,13 L22,7.5 M12,13 V22.5</StreamGeometry>
        <StreamGeometry x:Key="MinimizeGlyph">M5,12 H19</StreamGeometry>
        <StreamGeometry x:Key="MaximizeGlyph">M6,6 H18 V18 H6 Z</StreamGeometry>
        <StreamGeometry x:Key="RestoreGlyph">M8,6 H18 V16 M6,8 H16 V18 H6 Z</StreamGeometry>
        <StreamGeometry x:Key="CloseGlyph">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.rounded-window">
            <Setter Property="CornerRadius" Value="{StaticResource WindowRadius}" />
        </Style>
        <Style Selector="Border.instance-icon">
            <Setter Property="Background" Value="{StaticResource InstanceIconBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource InstanceIconRadius}" />
        </Style>
        <Style Selector="Border.floating">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
            <Setter Property="BoxShadow" Value="{arc:ArcDesignTokenResource ShadowRaised}" />
            <Setter Property="Padding" Value="{StaticResource FloatingPadding}" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        </Style>
        <Style Selector="Border.resize-grip">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="arc|Button.account-selection">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="arc|Button.instance-selection">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="arc|Avatar.dock-avatar">
            <Setter Property="Size" Value="Large" />
        </Style>
        <Style Selector="Border.compact-dock arc|Button.dock-selection">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.compact-dock arc|Avatar.dock-avatar">
            <Setter Property="Size" Value="Medium" />
        </Style>
        <Style Selector="Border.compact-dock :is(Control).dock-chevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="arc|Button.launch-button.launching">
            <Setter Property="Variant" Value="Secondary" />
        </Style>
        <Style Selector="arc|Button.launch-button.launching TextBlock">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
    </Window.Styles>

    <Grid>
        <Border x:Name="WindowFrame" Classes="rounded-window" Background="{StaticResource CanvasBrush}" />
        <Border CornerRadius="{Binding #WindowFrame.CornerRadius}" ClipToBounds="True" IsHitTestVisible="False">
            <Image Source="{Binding Settings.BackgroundImage}" Stretch="UniformToFill" />
        </Border>
        <Grid Margin="24,0" RowDefinitions="Auto,*,Auto,Auto">
            <Border Classes="floating" Margin="0,16,0,8" MaxWidth="864">
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                    <Border Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <arc:ArcGlyph Data="{StaticResource BrandGlyph}" Size="24"
                                          Foreground="{arc:ArcDesignTokenResource Accent}" />
                            <TextBlock Classes="heading" Text="HljuML" VerticalAlignment="Center"
                                       FontSize="{arc:ArcDesignTokenResource TypeLG}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <arc:Button x:Name="HomeButton" Size="Small" Variant="Secondary" Content="首页" Click="OnHomeClicked" />
                        <arc:Button x:Name="DownloadsButton" Size="Small" Variant="Ghost" Content="下载" Click="OnDownloadsClicked" />
                        <arc:Button x:Name="SettingsButton" Size="Small" Variant="Ghost" Content="设置" Click="OnSettingsClicked" />
                        <arc:Button Size="Small" Variant="Ghost" Content="输出日志" IsVisible="{Binding Settings.DebugMode}"
                                    Click="OnLogsClicked" ToolTip.Tip="查看当前会话最近 1000 条启动器日志；最低等级可在启动器设置中调整。" />
                    </StackPanel>
                    <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
                        <Border Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <arc:Button Size="Small" Width="32" Padding="0" Variant="Ghost"
                                        WindowDecorationProperties.ElementRole="MinimizeButton"
                                        AutomationProperties.Name="最小化" ToolTip.Tip="最小化" Click="OnMinimizeClicked">
                                <arc:ArcGlyph Data="{StaticResource MinimizeGlyph}" Size="16" IsHitTestVisible="False" />
                            </arc:Button>
                            <arc:Button x:Name="MaximizeButton" Size="Small" Width="32" Padding="0" Variant="Ghost"
                                        WindowDecorationProperties.ElementRole="MaximizeButton"
                                        AutomationProperties.Name="最大化" ToolTip.Tip="最大化" Click="OnMaximizeClicked">
                                <Grid IsHitTestVisible="False">
                                    <arc:ArcGlyph x:Name="MaximizeIcon" Data="{StaticResource MaximizeGlyph}" Size="16" />
                                    <arc:ArcGlyph x:Name="RestoreIcon" Data="{StaticResource RestoreGlyph}" Size="16" IsVisible="False" />
                                </Grid>
                            </arc:Button>
                            <arc:Button Size="Small" Width="32" Padding="0" Variant="Ghost"
                                        WindowDecorationProperties.ElementRole="CloseButton"
                                        AutomationProperties.Name="关闭窗口" ToolTip.Tip="关闭窗口" Click="OnCloseClicked">
                                <arc:ArcGlyph Data="{StaticResource CloseGlyph}" Size="16" IsHitTestVisible="False" />
                            </arc:Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer x:Name="PageScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="1080" Margin="0,16">
                    <StackPanel x:Name="HomePage" Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="heading" FontSize="{arc:ArcDesignTokenResource Type3XL}"
                                       Text="{Binding PlayerName, StringFormat='你好，{0}', FallbackValue='你好'}"
                                       TextWrapping="Wrap" />
                            <TextBlock Classes="secondary" Text="从这里开始你的 Minecraft 冒险。" TextWrapping="Wrap" />
                        </StackPanel>

                        <layout:MasonryPanel x:Name="HomeFeed" MinimumColumnWidth="260" MaximumColumns="3" Spacing="16">
                            <arc:Card layout:MasonryPanel.ColumnSpan="2"
                                      Title="{Binding InstanceName, FallbackValue='选择实例'}"
                                      Description="{Binding InstanceVersion}">
                                <arc:Card.Media>
                                    <Border MinHeight="116" Padding="20" Background="{StaticResource HeroBrush}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Classes="secondary" Text="JAVA EDITION" />
                                                <TextBlock Classes="heading" Text="Minecraft"
                                                           FontSize="{arc:ArcDesignTokenResource Type2XL}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Classes="instance-icon" Width="64" Height="64"
                                                    IsVisible="{Binding HasSelectedInstance}" />
                                        </Grid>
                                    </Border>
                                </arc:Card.Media>
                            </arc:Card>

                            <Border Background="{arc:ArcDesignTokenResource Surface}" BorderBrush="{arc:ArcDesignTokenResource Border}"
                                    BorderThickness="1" CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="heading" Text="正在运行的实例"
                                               FontSize="{arc:ArcDesignTokenResource TypeLG}" />
                                    <TextBlock Classes="secondary" Text="当前没有运行中的实例。"
                                               IsVisible="{Binding !HasRunningInstances, FallbackValue=True}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding RunningInstanceRows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RunningInstanceRow">
                                                <Border Padding="8" Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <Grid Width="46" Height="46" VerticalAlignment="Center">
                                                            <Border Classes="instance-icon" Width="40" Height="40"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                            <arc:Avatar Size="Small" DisplayName="{Binding Instance.PlayerName}"
                                                                        Source="{Binding PlayerAvatar}"
                                                                        CornerRadius="{arc:ArcDesignTokenResource RadiusStep6}"
                                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Classes="heading" Text="{Binding Instance.InstanceName}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Instance.InstanceName}" />
                                                            <TextBlock Classes="secondary" Text="{Binding Instance.PlayerName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="secondary" Text="{Binding Instance.AuthenticationMethod}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <arc:Button Grid.Column="2" Size="Small" Variant="Danger"
                                                                    Padding="8,0" VerticalAlignment="Center"
                                                                    Content="结束" AutomationProperties.Name="结束实例"
                                                                    Click="OnStopInstanceClicked" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <arc:Card Title="下载队列" Description="{Binding Downloads.Summary}" />
                            <arc:Card Title="最近游玩" Description="游玩记录区域 · 占位" />
                            <arc:Card Title="Minecraft 资讯" Description="游戏更新与公告 · 占位" />
                        </layout:MasonryPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <views:DownloadHubView x:Name="DownloadsPage" Grid.Row="1" IsVisible="False"
                                    MaxWidth="1080" Tag="{arc:ArcDesignTokenResource Space4}"
                                    Margin="{Binding $self.Tag, Converter={StaticResource UniformThicknessConverter}}"
                                    DataContext="{Binding DownloadHub}" />
            <views:SettingsView x:Name="SettingsPage" Grid.Row="1" IsVisible="False" MaxWidth="1080"
                                Tag="{arc:ArcDesignTokenResource Space4}"
                                Margin="{Binding $self.Tag, Converter={StaticResource UniformThicknessConverter}}"
                                DataContext="{Binding Settings}" />

            <arc:ToastStack Grid.Row="1" Label="通知" IsContained="True" />

            <arc:Button Grid.Row="2" Size="Small" Variant="Secondary"
                        HorizontalAlignment="Center" Content="查看下载管理器"
                        IsVisible="{Binding Downloads.HasPendingOrFailedTasks}"
                        Click="OnDownloadManagerClicked" />

            <Border Grid.Row="3" Classes="floating" Margin="0,8,0,16" MaxWidth="1040"
                    SizeChanged="OnLaunchDockSizeChanged">
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space3}">
                    <arc:Button x:Name="AccountButton" Classes="dock-selection account-selection"
                                Variant="Ghost" Size="Large" Click="OnAccountClicked"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding CanChangeLaunchSelection}"
                                AutomationProperties.Name="打开账户管理" ToolTip.Tip="账户管理">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space3}">
                            <arc:Avatar Classes="dock-avatar" VerticalAlignment="Center"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusStep8}"
                                        DisplayName="{Binding PlayerName, FallbackValue='选择玩家'}"
                                        Source="{Binding PlayerAvatar, FallbackValue='avares://HljuML.App/Assets/player-placeholder.png'}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="heading" Text="{Binding PlayerName, FallbackValue='选择玩家'}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="secondary" Text="{Binding AuthenticationMethod, FallbackValue='未选择档案'}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <arc:ArcGlyph Grid.Column="2" Classes="dock-chevron"
                                          Size="14" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Data="M 6,9 L 12,15 L 18,9" />
                        </Grid>
                    </arc:Button>
                    <arc:Button Grid.Column="1" Classes="dock-selection instance-selection" Variant="Ghost"
                                Size="Medium" VerticalAlignment="Center"
                                Click="OnChooseInstanceClicked" IsEnabled="{Binding CanChangeLaunchSelection}"
                                AutomationProperties.Name="选择游戏实例" ToolTip.Tip="{Binding InstanceName}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space2}">
                            <Border Classes="instance-icon" Width="36" Height="36" IsVisible="{Binding HasSelectedInstance}" />
                            <TextBlock Grid.Column="1" Classes="heading" Text="{Binding InstanceName, FallbackValue='选择实例'}"
                                       MaxWidth="128" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2" Classes="dock-chevron">
                                <arc:ArcGlyph Size="14" VerticalAlignment="Center" IsHitTestVisible="False"
                                              IsVisible="{Binding HasSelectedInstance}" Data="M 6,9 L 12,15 L 18,9" />
                            </Border>
                        </Grid>
                    </arc:Button>
                    <arc:Button x:Name="LaunchButton" Grid.Column="2" Classes="launch-button"
                                Classes.launching="{Binding IsLaunching}" VerticalAlignment="Center"
                                MinWidth="112" MaxWidth="160" Size="Medium"
                                Click="OnLaunchClicked"
                                IsEnabled="{Binding CanLaunchGame, FallbackValue=False}"
                                AutomationProperties.Name="{Binding LaunchLabel, FallbackValue='启动游戏'}"
                                ToolTip.Tip="{Binding LaunchStatus}">
                        <StackPanel MaxWidth="128" Spacing="{arc:ArcDesignTokenResource Space1}">
                            <TextBlock Text="{Binding LaunchLabel, FallbackValue='启动游戏'}"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding LaunchDetail}" IsVisible="{Binding HasLaunchDetail}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </arc:Button>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ResizeGrips" RowDefinitions="6,*,6" ColumnDefinitions="6,*,6">
            <Border Classes="resize-grip" WindowDecorationProperties.ElementRole="ResizeNW" />
            <Border Classes="resize-grip" Grid.Column="1" WindowDecorationProperties.ElementRole="ResizeN" />
            <Border Classes="resize-grip" Grid.Column="2" WindowDecorationProperties.ElementRole="ResizeNE" />
            <Border Classes="resize-grip" Grid.Row="1" WindowDecorationProperties.ElementRole="ResizeW" />
            <Border Classes="resize-grip" Grid.Row="1" Grid.Column="2" WindowDecorationProperties.ElementRole="ResizeE" />
            <Border Classes="resize-grip" Grid.Row="2" WindowDecorationProperties.ElementRole="ResizeSW" />
            <Border Classes="resize-grip" Grid.Row="2" Grid.Column="1" WindowDecorationProperties.ElementRole="ResizeS" />
            <Border Classes="resize-grip" Grid.Row="2" Grid.Column="2" WindowDecorationProperties.ElementRole="ResizeSE" />
        </Grid>
        <Border x:Name="SelectionScrim" IsVisible="False" IsHitTestVisible="False"
                CornerRadius="{Binding #WindowFrame.CornerRadius}"
                Background="{arc:ArcDesignTokenResource Scrim}" />
        <views:ModpackImportDialog DataContext="{Binding ModpackImport}" />
    </Grid>
</Window>
