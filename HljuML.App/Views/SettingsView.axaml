<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:HljuML.App.Core"
             xmlns:settings="using:HljuML.App.Views.Settings"
             x:Class="HljuML.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{arc:ArcDesignTokenResource Space4}">
        <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
            <arc:Button Content="游戏设置"
                        Classes="app-nav"
                        Classes.active="{Binding IsGame}"
                        Tag="Game"
                        Click="OnSectionClicked"
                        ToolTip.Tip="启动选项、内存分配、JVM 参数及默认 Java 环境。" />
            <arc:Button Content="启动器设置"
                        Classes="app-nav"
                        Classes.active="{Binding IsLauncher}"
                        Tag="Launcher"
                        Click="OnSectionClicked"
                        ToolTip.Tip="下载、在线服务、调试日志与启动器外观。" />
            <arc:Button Content="关于"
                        Classes="app-nav"
                        Classes.active="{Binding IsAbout}"
                        Tag="About"
                        Click="OnSectionClicked"
                        ToolTip.Tip="查看启动器版本、法律声明与开发人员。" />
        </StackPanel>
        <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{arc:ArcDesignTokenResource Space4}">
                <arc:Alert Title="设置未保存" Content="{Binding ErrorMessage}" Tone="Danger" IsVisible="{Binding HasError}" />
                <settings:GameSettingsView IsVisible="{Binding IsGame}" />
                <settings:LauncherSettingsView IsVisible="{Binding IsLauncher}" />
                <settings:AboutSettingsView IsVisible="{Binding IsAbout}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>