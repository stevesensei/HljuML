<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:HljuML.App.Core"
             xmlns:controls="using:HljuML.App.Controls"
             xmlns:layout="using:HljuML.App.Controls"
             x:Class="HljuML.App.Views.Home.HomeView"
             x:DataType="vm:MainViewModel">
    <StackPanel Spacing="20">
        <controls:PageHeader Title="{Binding PlayerName, StringFormat='你好，{0}', FallbackValue='你好'}"
                             Description="从这里开始你的 Minecraft 冒险。"
                             TitleFontSize="{arc:ArcDesignTokenResource Type3XL}" />
        <layout:MasonryPanel x:Name="HomeFeed" MinimumColumnWidth="260" MaximumColumns="3" Spacing="16">
            <arc:Card layout:MasonryPanel.ColumnSpan="2"
                      Title="{Binding InstanceName, FallbackValue='选择实例'}"
                      Description="{Binding InstanceVersion}">
                <arc:Card.Media>
                    <Border MinHeight="116" Padding="20" Background="{StaticResource HeroBrush}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="app-description" Text="JAVA EDITION" />
                                <TextBlock Classes="app-heading"
                                           Text="Minecraft"
                                           FontSize="{arc:ArcDesignTokenResource Type2XL}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Classes="instance-icon"
                                    Width="64"
                                    Height="64"
                                    IsVisible="{Binding HasSelectedInstance}" />
                        </Grid>
                    </Border>
                </arc:Card.Media>
            </arc:Card>
            <Border Classes="app-panel" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Classes="app-heading" Text="正在运行的实例" FontSize="{arc:ArcDesignTokenResource TypeLG}" />
                    <TextBlock Classes="app-description"
                               Text="当前没有运行中的实例。"
                               IsVisible="{Binding !HasRunningInstances, FallbackValue=True}"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding RunningInstanceRows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RunningInstanceRow">
                                <Border Padding="8"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Grid Width="46" Height="46" VerticalAlignment="Center">
                                            <Border Classes="instance-icon"
                                                    Width="40"
                                                    Height="40"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top" />
                                            <arc:Avatar Size="Small"
                                                        DisplayName="{Binding Instance.PlayerName}"
                                                        Source="{Binding PlayerAvatar}"
                                                        CornerRadius="{arc:ArcDesignTokenResource RadiusStep6}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="app-heading"
                                                       Text="{Binding Instance.InstanceName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Instance.InstanceName}" />
                                            <TextBlock Classes="app-description"
                                                       Text="{Binding Instance.PlayerName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="app-description"
                                                       Text="{Binding Instance.AuthenticationMethod}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <arc:Button Grid.Column="2"
                                                    Size="Small"
                                                    Variant="Danger"
                                                    Padding="8,0"
                                                    VerticalAlignment="Center"
                                                    Content="结束"
                                                    AutomationProperties.Name="结束实例"
                                                    Click="OnStopInstanceClicked" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <arc:Card Title="下载队列" Description="{Binding Downloads.Summary}" />
            <arc:Card Title="最近游玩" Description="游玩记录区域 · 占位" />
            <arc:Card Title="Minecraft 资讯" Description="游戏更新与公告 · 占位" />
        </layout:MasonryPanel>
    </StackPanel>
</UserControl>