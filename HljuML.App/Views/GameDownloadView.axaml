<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:HljuML.App.Core"
             xmlns:downloads="using:HljuML.App.Views.Downloads"
             x:Class="HljuML.App.Views.GameDownloadView"
             x:Name="DownloadRoot"
             x:DataType="vm:GameDownloadViewModel">
    <Border MaxWidth="920"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="{arc:ArcDesignTokenResource Surface}"
            BorderBrush="{arc:ArcDesignTokenResource Border}"
            BorderThickness="1"
            CornerRadius="{arc:ArcDesignTokenResource RadiusSurface}"
            Tag="{arc:ArcDesignTokenResource Space5}"
            Padding="{Binding $self.Tag, Converter={StaticResource UniformThicknessConverter}}">
        <Grid>
            <downloads:GameCatalogView IsVisible="{Binding IsBrowsing}" />
            <downloads:GameInstallationView IsVisible="{Binding IsConfiguring}" />
        </Grid>
    </Border>
</UserControl>