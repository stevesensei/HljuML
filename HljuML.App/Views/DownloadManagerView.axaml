<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:HljuML.App.Core"
             xmlns:controls="using:HljuML.App.Controls"
             x:Class="HljuML.App.Views.DownloadManagerView"
             x:DataType="vm:DownloadQueueViewModel">
    <StackPanel Spacing="{arc:ArcDesignTokenResource Space4}">
        <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
            <controls:PageHeader Title="下载管理器"
                                 Description="{Binding Summary}"
                                 TitleFontSize="{arc:ArcDesignTokenResource Type3XL}" />
            <TextBlock Classes="app-description" Text="关闭窗口后下载会继续，本次运行的任务结果会保留。" TextWrapping="Wrap" />
        </StackPanel>
        <Border Classes="app-panel" IsVisible="{Binding !HasTasks}">
            <arc:EmptyState Title="当前没有下载任务">
                <arc:EmptyState.Icon>
                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Download}" Size="{arc:ArcDesignTokenResource Space6}" />
                </arc:EmptyState.Icon>
            </arc:EmptyState>
        </Border>
        <ItemsControl ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="{arc:ArcDesignTokenResource Space3}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadTaskViewModel">
                    <Border Classes="app-panel"
                            Tag="{arc:ArcDesignTokenResource Space5}"
                            Padding="{Binding $self.Tag, Converter={StaticResource UniformThicknessConverter}}">
                        <StackPanel Spacing="{arc:ArcDesignTokenResource Space3}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space3}">
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Download}"
                                              Size="{arc:ArcDesignTokenResource Space5}"
                                              Foreground="{arc:ArcDesignTokenResource Accent}"
                                              VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Classes="app-heading"
                                           FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Name}" />
                                <TextBlock Grid.Column="2"
                                           Classes="app-description"
                                           Text="{Binding Status}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Classes="app-description"
                                       Text="{Binding Phase}"
                                       IsVisible="{Binding HasPhase}"
                                       TextWrapping="Wrap" />
                            <arc:Progress Label="{Binding ProgressLabel}"
                                          Maximum="100"
                                          Value="{Binding ProgressValue, Mode=OneWay}"
                                          IsValueVisible="True"
                                          IsVisible="{Binding HasProgress}" />
                            <TextBlock Classes="app-description" Text="{Binding Summary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Error}"
                                       IsVisible="{Binding HasError}"
                                       TextWrapping="Wrap"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       Foreground="{arc:ArcDesignTokenResource Danger}" />
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DownloadFileRow">
                                        <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                Tag="{arc:ArcDesignTokenResource Space3}"
                                                Padding="{Binding $self.Tag, Converter={StaticResource UniformThicknessConverter}}">
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <TextBlock Classes="app-heading"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Name}" />
                                                <TextBlock Classes="app-description"
                                                           Text="{Binding Summary}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>