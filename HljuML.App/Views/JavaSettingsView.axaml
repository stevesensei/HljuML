<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:HljuML.App.Core"
             x:Class="HljuML.App.Views.JavaSettingsView"
             x:DataType="vm:JavaSettingsViewModel">
    <arc:Card Title="Java 运行环境" Description="选择立即保存，启动时自动检查并匹配最接近要求的版本。">
        <StackPanel Spacing="{arc:ArcDesignTokenResource Space4}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space3}">
                <arc:Select Label="默认 Java 环境"
                            ToolTip.Tip="启动时优先匹配实例推荐的 Java 主版本，否则选择高于要求且差值最小的版本。同一主版本下优先实例配置，其次全局默认。没有满足要求的环境时停止启动；同目录优先使用 javaw.exe。"
                            Description="可在列表底部手动选择 javaw.exe 或 java.exe。"
                            ItemsSource="{Binding JavaOptions}"
                            SelectedItem="{Binding SelectedJavaOption, Mode=TwoWay}"
                            IsEnabled="{Binding CanScan}"
                            SelectionChanged="OnJavaSelectionChanged"
                            HorizontalAlignment="Stretch" />
                <arc:Button Grid.Column="1" Content="扫描 Java" Variant="Secondary" IsLoading="{Binding IsScanning}"
                            IsEnabled="{Binding CanScan}" Click="OnScanJavaClicked" VerticalAlignment="Center"
                            ToolTip.Tip="刷新本机 Java 列表；每次启动启动器时也会自动扫描。扫描不会删除手动选择的默认 Java。" />
            </Grid>
            <TextBlock Text="{Binding SelectedPathDescription}" TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                       FontSize="{arc:ArcDesignTokenResource TypeSM}" />
            <TextBlock Text="{Binding ScanStatus}" TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                       FontSize="{arc:ArcDesignTokenResource TypeSM}" />
            <arc:Alert Title="Java 设置需要处理" Content="{Binding ErrorMessage}"
                       Tone="Danger" IsVisible="{Binding HasError}" />
        </StackPanel>
    </arc:Card>
</UserControl>
