<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        x:Class="HljuML.App.Views.LogWindow" Title="输出日志 · HljuML"
        Width="900" Height="560" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" Background="{arc:ArcDesignTokenResource Background}">
    <Grid RowDefinitions="Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space3}">
        <TextBlock Text="当前会话 · 最近 1000 条 · 完整日志保存在本地 logs 目录"
                   TextWrapping="Wrap" Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                   ToolTip.Tip="最低日志等级在启动器设置中调整。分享日志前请检查个人信息。" />
        <Border Grid.Row="1" x:Name="LogArea">
            <arc:Textarea x:Name="LogOutput" Label="启动器日志" IsLabelVisible="False" IsReadOnly="True"
                          IsResizable="False" FrameHeight="{Binding #LogArea.Bounds.Height}"
                          ToolTip.Tip="可选择和复制日志。每秒自动刷新，完整记录保存在本地日志文件。"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TextWrapping="NoWrap"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Window>